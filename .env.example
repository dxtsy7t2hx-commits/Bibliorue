# Réglages de Bibliorue.
# Copiez ce fichier sous le nom « .env » (avec le point au début), puis modifiez les valeurs.
# Le fichier .env n'est jamais envoyé sur GitHub (il est listé dans .gitignore).

# Port local : l'application sera sur http://localhost:8080
PORT=8080

# Fichier de la base de données (créé automatiquement au premier lancement)
DATABASE_PATH=./data/bibliorue.db

# E-mail(s) des modérateurs, séparés par des virgules.
# Créez ensuite un compte avec cet e-mail : il aura les droits de modération.
ADMIN_EMAILS=

# Mettez 1 quand l'application est en ligne derrière un hébergeur (Railway, Render, Fly.io…)
TRUST_PROXY=0
