# Copiez ce fichier en .env (ou saisissez ces variables chez votre hébergeur).
PORT=8080
DATABASE_PATH=./data/bibliorue.db
# E-mails des modérateurs (séparés par des virgules) : ils peuvent corriger/supprimer
# n'importe quelle boîte et voient les signalements.
ADMIN_EMAILS=
# 1 si le serveur est derrière un proxy HTTPS (Render, Fly.io, Railway, Nginx…)
TRUST_PROXY=0
